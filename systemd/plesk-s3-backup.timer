[Unit]
Description=Daily Plesk backup to S3
Documentation=https://github.com/DRodero/plesk-s3-backup

[Timer]
# Change the time with: systemctl edit plesk-s3-backup.timer
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=10m
# Run on boot if the server was off at the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
